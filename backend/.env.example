# Copy to backend/.env when running outside Docker.
DEPRADAR_DATABASE_URL=postgresql+psycopg://depradar:depradar@localhost:5432/depradar
DEPRADAR_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
DEPRADAR_ALLOWED_ORIGIN=http://localhost:8000
DEPRADAR_SECURE_COOKIES=false
DEPRADAR_STORAGE_DIR=data/inventories
# Scanner must be a private, trusted service URL.
DEPRADAR_SCANNER_URL=http://localhost:8001
# Secrets are environment-only; the database stores connector metadata, not these values.
DEPRADAR_SMTP_PASSWORD=
DEPRADAR_TELEGRAM_BOT_TOKEN=
DEPRADAR_DASHBOARD_URL=http://localhost:8000
# Use true only with a trusted local SMTP capture/relay. Normal SMTP requires TLS.
DEPRADAR_ALLOW_INSECURE_SMTP=false
