    ):
        raise Abort("Nothing was changed")
    with ui.task("Removing containers") as task:
        compose(
            "down",
            "--remove-orphans",
            *(["--volumes", "--rmi", "local"] if args.purge else []),
            task=task,
        )
    for unit in ("depradar-backup.timer", "depradar-backup.service"):
        if (UNIT_DIR / unit).exists():
            run(["systemctl", "disable", "--now", unit], check=False)
            (UNIT_DIR / unit).unlink()
    if shutil.which("systemctl"):
        run(["systemctl", "daemon-reload"], check=False)
    if BIN_LINK.is_symlink():
        BIN_LINK.unlink()
    if args.purge:
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)
        ui.ok("Containers, data, and settings removed")
        if backups_on_disk():
            ui.info(
                f"Backups were kept in {BACKUP_DIR}; delete them yourself when no longer needed."
            )
    else:
        ui.ok("Containers removed; data volumes and settings were kept")
        ui.info(f"Reinstall with: sudo {ROOT / 'deploy' / 'depradarctl'} install")
    ui.emit()


# ─── Entry point ─────────────────────────────────────────────────────────────────────────────


@contextmanager
def exclusive(command: str) -> Iterator[None]:
    """One mutating operation at a time, including the backup timer."""
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Abort(
                "Another depradarctl operation is running", "Wait for it to finish, then retry."
            ) from None
        handle.write(f"{os.getpid()} {command}\n")
        handle.flush()
        yield


def open_log() -> None:
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(LOG_DIR, 0o700)
        descriptor = os.open(
            LOG_DIR / "depradarctl.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600
        )
        ui.log = os.fdopen(descriptor, "a")
        ui.log.write(f"\n=== {now()} depradarctl {TOOL_VERSION}: {shlex.join(sys.argv[1:])}\n")
    except OSError:
        ui.log = None


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        prog="depradarctl",
        description="Install and operate DepRadar on a Linux server.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Run `depradarctl <command> --help` for a command's options. Docs: docs/DEPLOYMENT.md",
    )
    root.add_argument("--version", action="version", version=f"depradarctl {TOOL_VERSION}")
    commands = root.add_subparsers(dest="command", required=True, metavar="<command>")

    def settings_options(command: argparse.ArgumentParser) -> None:
        command.add_argument(
            "--mode", choices=list(MODES), help="How DepRadar is reached (default: https)"
        )
        command.add_argument("--domain", help="Domain name (https, tls-internal)")
        command.add_argument("--email", help="Email for Let's Encrypt expiry notices (https)")
        command.add_argument("--public-url", help="Public origin served by your proxy (proxy mode)")
        command.add_argument("--host", help="Hostname or IP users open (http mode)")
        command.add_argument("--port", type=int, help="Listening port (tls-internal, proxy, http)")
        command.add_argument("--bind", help="Address to listen on (http mode, default 0.0.0.0)")
        command.add_argument(
            "--smtp-password-file", metavar="FILE", help="File holding the SMTP password"
        )
        command.add_argument(
            "--telegram-token-file", metavar="FILE", help="File holding the Telegram bot token"
        )
        command.add_argument(
            "--no-backups", action="store_true", help="Do not schedule daily backups"
        )
        command.add_argument(
            "--keep-backups", type=int, metavar="N", help="Daily archives to keep (default 14)"
        )
        command.add_argument(
            "-y", "--yes", action="store_true", help="Accept defaults; never prompt"
        )

    install = commands.add_parser("install", help="Install, or resume an interrupted installation")
    settings_options(install)
    install.add_argument(
        "--owner-password-file", metavar="FILE", help="Create the owner non-interactively"
    )
    install.add_argument(
        "--reconfigure", action="store_true", help="Ask for settings again on an existing install"
    )
    install.add_argument(
        "--no-firewall", action="store_true", help="Leave the host firewall unchanged"
    )
    install.add_argument("--no-swap", action="store_true", help="Never create a swap file")
    install.set_defaults(handler=cmd_install, mutating=True)

    configure = commands.add_parser(
        "configure", help="Change the address, mode, secrets, or backups"
    )
    settings_options(configure)
    configure.set_defaults(handler=cmd_configure, mutating=True)

    status = commands.add_parser("status", help="Services, endpoint, certificate, and backups")
    status.add_argument("--json", action="store_true", help="Machine-readable output")
    status.set_defaults(handler=cmd_status, mutating=False)

    upgrade = commands.add_parser(
        "upgrade", help="Back up, update, verify, and roll back on failure"
    )
    upgrade.add_argument(
        "--ref", help="Branch, tag, or commit (default: the remote's default branch)"
    )
    upgrade.add_argument(
        "--rebuild", action="store_true", help="Rebuild even when already up to date"
    )
    upgrade.add_argument("--skip-backup", action="store_true", help="Skip the pre-upgrade backup")
    upgrade.add_argument(
        "--force", action="store_true", help="Upgrade despite local source changes"
    )
    upgrade.add_argument("-y", "--yes", action="store_true")
    upgrade.set_defaults(handler=cmd_upgrade, mutating=True)

    backup = commands.add_parser(
        "backup", help="Create a verified archive in /var/backups/depradar"
    )
    backup.add_argument("--keep", type=int, metavar="N", help="Scheduled archives to keep")
    backup.add_argument("--quiet", action="store_true", help="Minimal output, for timers")
    backup.set_defaults(handler=cmd_backup, mutating=True)

    restore = commands.add_parser("restore", help="Replace all data with a verified archive")
    restore.add_argument("file", help="Archive created by `depradarctl backup`")
    restore.add_argument(
        "--no-safety-backup", action="store_true", help="Do not back up current data first"
    )
    restore.add_argument("-y", "--yes", action="store_true")
    restore.set_defaults(handler=cmd_restore, mutating=True)

    doctor = commands.add_parser("doctor", help="Diagnose the host, configuration, and services")
    doctor.set_defaults(handler=cmd_doctor, mutating=False)

    logs = commands.add_parser("logs", help="Show service logs")
    logs.add_argument(
        "services", nargs="*", metavar="SERVICE", help="Any of: " + ", ".join(SERVICES)
    )
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("-n", "--tail", type=int, default=200)
    logs.set_defaults(handler=cmd_logs, mutating=False)

    for name, text in (
        ("start", "Start services"),
        ("stop", "Stop services"),
        ("restart", "Recreate services"),
    ):
        commands.add_parser(name, help=text).set_defaults(handler=cmd_lifecycle, mutating=True)

    owner = commands.add_parser("owner", help="Create the owner account or reset its password")
    owner.add_argument("action", choices=["setup", "reset-password"])
    owner.add_argument(
        "--owner-password-file", metavar="FILE", help="Read the new owner's password from a file"
    )
    owner.set_defaults(handler=cmd_owner, mutating=True)

    uninstall = commands.add_parser(
        "uninstall", help="Remove containers; --purge also deletes data"
    )
    uninstall.add_argument(
        "--purge", action="store_true", help="Also delete data volumes and settings"
    )
    uninstall.add_argument("-y", "--yes", action="store_true")
    uninstall.set_defaults(handler=cmd_uninstall, mutating=True)
    return root


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    ui.assume_yes = bool(getattr(args, "yes", False))
    if os.geteuid() == 0:
        open_log()
    else:
        ui.banner(args.command)
        ui.emit()
        ui.fail("This command needs root", f"Run: sudo {shlex.join(sys.argv)}")
        ui.emit()
        return 1
    try:
        if args.mutating:
            with exclusive(args.command):
                args.handler(args)
        else:
            args.handler(args)
        return 0
    except Abort as error:
        ui.active = None
        ui.emit(force=True)
        ui.fail(str(error), error.hint)
        ui.emit(force=True)
        return 1
    except KeyboardInterrupt:
        ui.active = None
        ui.emit(force=True)
        ui.warn("Interrupted. Re-run the same command to continue; every step is safe to repeat.")
        ui.emit(force=True)
        return 130


if __name__ == "__main__":
    sys.exit(main())
