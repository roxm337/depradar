# ─── Terminal interface ──────────────────────────────────────────────────────────────────────


class Abort(Exception):
    """A failure the operator can act on: a message and, ideally, what to do next."""

    def __init__(self, message: str, hint: str = "") -> None:
        super().__init__(message)
        self.hint = hint


class UI:
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self) -> None:
        self.tty = sys.stdout.isatty()
        self.color = (
            self.tty and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"
        )
        self.interactive = sys.stdin.isatty() and self.tty
        self.assume_yes = False
        self.quiet = False
        self.lock = threading.Lock()
        self.active: Task | None = None
        self.log: Any = None

    def style(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.color else text

    def bold(self, text: str) -> str:
        return self.style("1", text)

    def dim(self, text: str) -> str:
        return self.style("2", text)

    def accent(self, text: str) -> str:
        return self.style("36", text)

    def emit(self, line: str = "", *, force: bool = False) -> None:
        if self.quiet and not force:
            self.record(line)
            return
        with self.lock:
            if self.active and self.tty:
                sys.stdout.write("\r\033[2K")
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        self.record(line)

    def record(self, line: str) -> None:
        if self.log:
            self.log.write(ANSI.sub("", line) + "\n")
            self.log.flush()

    def banner(self, subtitle: str) -> None:
        self.emit()
        self.emit(f"  {self.bold('DepRadar')} {self.dim('·')} {subtitle}")
        self.emit(self.dim("  " + "─" * 58))

    def section(self, title: str) -> None:
        self.emit()
        self.emit(f"  {self.accent('◆')} {self.bold(title)}")

    def ok(self, text: str, detail: str = "") -> None:
        self.emit(
            f"    {self.style('32', '✓')} {text}" + (f"  {self.dim(detail)}" if detail else "")
        )

    def warn(self, text: str, hint: str = "") -> None:
        self.emit(f"    {self.style('33', '!')} {text}", force=True)
        self.hint(hint)

    def fail(self, text: str, hint: str = "", detail: str = "") -> None:
        suffix = f"  {self.dim(detail)}" if detail else ""
        self.emit(f"    {self.style('31', '✗')} {text}{suffix}", force=True)
        self.hint(hint)

    def hint(self, text: str) -> None:
        for line in text.splitlines():
            self.emit(f"      {self.dim(line.strip())}", force=True)

    def info(self, text: str) -> None:
        self.emit(f"    {self.dim('·')} {text}")

    def task(self, label: str) -> Task:
        return Task(self, label)

    # Prompts never run while a spinner is active and never echo secrets to the log.
    def ask(
        self,
        label: str,
        default: str | None = None,
        *,
        validate: Callable[[str], str | None] | None = None,
        secret: bool = False,
        optional: bool = False,
    ) -> str:
        if not self.interactive or self.assume_yes:
            if default is not None or optional:
                return default or ""
            raise Abort(f"{label} is required", "Pass it as a command-line option.")
        suffix = f" {self.dim(f'[{default}]')}" if default and not secret else ""
        suffix += f" {self.dim('(optional)')}" if optional and not default else ""
        while True:
            prompt = f"    {self.accent('?')} {label}{suffix} {self.dim('›')} "
            value = getpass.getpass(prompt) if secret else input(prompt)
            # Secrets are kept exactly as typed; other answers ignore surrounding spaces.
            value = (value if secret else value.strip()) or (default or "")
            if not value and optional:
                return ""
            error = validate(value) if validate else (None if value else "A value is required")
            if not error:
                self.record(f"    ? {label} › {'(hidden)' if secret else value}")
                return value
            self.emit(f"      {self.style('31', error)}", force=True)

    def confirm(self, label: str, default: bool = True) -> bool:
        if not self.interactive or self.assume_yes:
            return default if not self.assume_yes else True
        hint = "Y/n" if default else "y/N"
        while True:
            answer = input(f"    {self.accent('?')} {label} {self.dim(f'({hint})')} › ")
            answer = answer.strip().lower()
            if not answer:
                return default
            if answer in {"y", "yes", "n", "no"}:
                return answer.startswith("y")

    def choose(self, label: str, options: dict[str, str], default: str) -> str:
        if not self.interactive or self.assume_yes:
            return default
        keys = list(options)
        self.emit(f"    {self.accent('?')} {label}")
        for index, key in enumerate(keys, 1):
            marker = self.accent("›") if key == default else " "
            self.emit(f"      {marker} {index}. {self.bold(key):<24} {self.dim(options[key])}")
        while True:
            raw = input(f"      {self.dim(f'Choice [{keys.index(default) + 1}]')} › ").strip()
            if not raw:
                return default
            if raw.isdigit() and 1 <= int(raw) <= len(keys):
                return keys[int(raw) - 1]
            if raw in options:
                return raw

    def typed_confirmation(self, word: str, consequence: str) -> None:
        self.warn(consequence)
        if self.assume_yes:
            return
        if not self.interactive:
            raise Abort("Confirmation required", "Re-run interactively, or pass --yes.")
        if input(f"    {self.accent('?')} Type {self.bold(word)} to continue › ").strip() != word:
            raise Abort("Not confirmed; nothing was changed")

    def card(self, title: str, rows: list[tuple[str, str]]) -> None:
        inner = max([len(title) + 5] + [len(value) + 16 for _, value in rows])
        frame = lambda text: self.style("32", text)  # noqa: E731
        self.emit()
        self.emit(
            "  "
            + frame("╭─ ")
            + self.bold(title)
            + frame(" " + "─" * (inner - len(title) - 3) + "╮")
        )
        for key, value in rows:
            padding = " " * (inner - 14 - len(value))
            self.emit(
                "  " + frame("│") + "  " + self.dim(key.ljust(12)) + value + padding + frame("│")
            )
        self.emit("  " + frame("╰" + "─" * inner + "╯"))


class Task:
    """A long step: a live spinner with elapsed time and the latest output line."""

    def __init__(self, ui: UI, label: str) -> None:
        self.ui = ui
        self.label = label
        self.last = ""
        self.started = 0.0
        self.stop = threading.Event()
        self.thread: threading.Thread | None = None

    def note(self, line: str) -> None:
        cleaned = ANSI.sub("", line).strip()
        if cleaned:
            self.last = cleaned

    def elapsed(self) -> str:
        seconds = int(time.monotonic() - self.started)
        return f"{seconds // 60}m{seconds % 60:02d}s" if seconds >= 60 else f"{seconds}s"

    def spin(self) -> None:
        frame = 0
        while not self.stop.wait(0.1):
            width = shutil.get_terminal_size((100, 20)).columns
            head = f"    {self.ui.accent(UI.FRAMES[frame % len(UI.FRAMES)])} {self.label}  {self.ui.dim(self.elapsed())}"
            room = width - len(ANSI.sub("", head)) - 6
            tail = f"  {self.ui.dim(self.last[:room])}" if room > 10 and self.last else ""
            with self.ui.lock:
                sys.stdout.write("\r\033[2K" + head + tail)
                sys.stdout.flush()
            frame += 1

    def __enter__(self) -> Task:
        self.started = time.monotonic()
        self.ui.active = self
        if self.ui.tty and not self.ui.quiet:
            self.thread = threading.Thread(target=self.spin, daemon=True)
            self.thread.start()
        else:
            self.ui.emit(f"    … {self.label}")
        return self

    def __exit__(self, kind: Any, error: Any, trace: Any) -> None:
        self.stop.set()
        if self.thread:
            self.thread.join()
            with self.ui.lock:
                sys.stdout.write("\r\033[2K")
                sys.stdout.flush()
        self.ui.active = None
        if kind is None:
            self.ui.ok(self.label, self.elapsed())
        elif kind is not KeyboardInterrupt:
            self.ui.fail(self.label, detail=self.elapsed())


ui = UI()


