def download(url: str, destination: Path) -> None:
    with urllib.request.urlopen(url, timeout=60) as response:  # noqa: S310 - fixed HTTPS URLs
        data = response.read()
    write_private(destination, data.decode(), 0o644)


def install_docker(release: dict[str, str]) -> None:
    family = {release.get("ID", ""), *release.get("ID_LIKE", "").split()}
    distro = release.get("ID", "")
    with ui.task("Installing Docker Engine from download.docker.com") as task:
        if family & {"debian", "ubuntu"}:
            repo = (
                "ubuntu"
                if (distro == "ubuntu" or "ubuntu" in family and release.get("UBUNTU_CODENAME"))
                else "debian"
            )
            codename = (
                release.get("UBUNTU_CODENAME")
                if repo == "ubuntu"
                else release.get("VERSION_CODENAME")
            )
            if not codename:
                raise Abort("Cannot determine the distribution codename for the Docker repository")
            env = {"DEBIAN_FRONTEND": "noninteractive"}
            run(["apt-get", "update", "-q"], task=task, env=env)
            run(["apt-get", "install", "-y", "-q", "ca-certificates"], task=task, env=env)
            download(
                f"https://download.docker.com/linux/{repo}/gpg",
                Path("/etc/apt/keyrings/docker.asc"),
            )
            _, arch = run(["dpkg", "--print-architecture"], capture=True)
            write_private(
                Path("/etc/apt/sources.list.d/docker.list"),
                f"deb [arch={arch.strip()} signed-by=/etc/apt/keyrings/docker.asc] "
                f"https://download.docker.com/linux/{repo} {codename} stable\n",
                0o644,
            )
            run(["apt-get", "update", "-q"], task=task, env=env)
            run(
                [
                    "apt-get",
                    "install",
                    "-y",
                    "-q",
                    "docker-ce",
                    "docker-ce-cli",
                    "containerd.io",
                    "docker-buildx-plugin",
                    "docker-compose-plugin",
                ],
                task=task,
                env=env,
            )
        elif family & {"fedora", "rhel", "centos"}:
            repo = "fedora" if "fedora" in family else ("centos" if distro == "centos" else "rhel")
            download(
                f"https://download.docker.com/linux/{repo}/docker-ce.repo",
                Path("/etc/yum.repos.d/docker-ce.repo"),
            )
            run(
                [
                    "dnf",
                    "-y",
                    "install",
                    "docker-ce",
                    "docker-ce-cli",
                    "containerd.io",
                    "docker-buildx-plugin",
                    "docker-compose-plugin",
                ],
                task=task,
            )
        else:
            raise Abort(
                f"Automatic Docker installation is not available for {release.get('PRETTY_NAME', 'this system')}",
                "Install Docker Engine with the Compose plugin (https://docs.docker.com/engine/install/), then re-run.",
            )
        run(["systemctl", "enable", "--now", "docker"], task=task)


def install_package(name: str, release: dict[str, str]) -> None:
    family = {release.get("ID", ""), *release.get("ID_LIKE", "").split()}
    with ui.task(f"Installing {name}") as task:
        if family & {"debian", "ubuntu"}:
            run(
                ["apt-get", "install", "-y", "-q", name],
                task=task,
                env={"DEBIAN_FRONTEND": "noninteractive"},
            )
        elif family & {"fedora", "rhel", "centos"}:
            run(["dnf", "-y", "install", name], task=task)
        else:
            raise Abort(f"Install {name} with your package manager, then re-run")


def create_swap(size_gib: int = 2) -> None:
    path = Path("/swapfile")
    with ui.task(f"Creating a {size_gib} GiB swap file for image builds") as task:
        if not path.exists():
            run(["fallocate", "-l", f"{size_gib}G", str(path)], task=task)
            os.chmod(path, 0o600)
            run(["mkswap", str(path)], task=task)
        run(["swapon", str(path)], task=task, check=False)
        fstab = Path("/etc/fstab")
        if str(path) not in fstab.read_text():
            with fstab.open("a") as stream:
                stream.write(f"{path} none swap sw 0 0\n")


def open_firewall(state: dict[str, Any]) -> None:
    if state["mode"] in {"https", "tls-internal"} and tls_port(state) == 443:
        ports = ["80/tcp", "443/tcp", "443/udp"]
    elif state["mode"] == "tls-internal":
        ports = [f"{tls_port(state)}/tcp", f"{tls_port(state)}/udp"]
    else:
        ports = [f"{state['port']}/tcp"] if state["mode"] == "http" else []
    if not ports:
        return
    if shutil.which("ufw"):
        code, out = run(["ufw", "status"], check=False, capture=True)
        if code == 0 and "Status: active" in out:
            for port in ports:
                run(["ufw", "allow", port])
            ui.ok("Opened " + ", ".join(ports) + " in ufw")
            return
    if shutil.which("firewall-cmd"):
        code, _ = run(["firewall-cmd", "--state"], check=False)
        if code == 0:
            for port in ports:
                run(["firewall-cmd", "--permanent", f"--add-port={port}"])
            run(["firewall-cmd", "--reload"])
            ui.ok("Opened " + ", ".join(ports) + " in firewalld")
            return
    ui.info(
        "No active host firewall found; check your cloud provider's firewall allows "
        + ", ".join(ports)
    )


def install_backup_timer() -> bool:
    if not Path("/run/systemd/system").exists():
        ui.warn(
            "systemd is not running; daily backups were not scheduled",
            "Run `depradarctl backup` from your own scheduler.",
        )
        return False
    write_private(
        UNIT_DIR / "depradar-backup.service",
        "[Unit]\nDescription=DepRadar verified backup\nAfter=docker.service\nRequires=docker.service\n\n"
        "[Service]\nType=oneshot\nExecStart=/usr/local/bin/depradarctl backup --quiet\n"
        "Nice=10\nIOSchedulingClass=idle\n",
        0o644,
    )
    write_private(
        UNIT_DIR / "depradar-backup.timer",
        "[Unit]\nDescription=Daily DepRadar backup\n\n"
        "[Timer]\nOnCalendar=*-*-* 03:15:00\nRandomizedDelaySec=20m\nPersistent=true\n\n"
        "[Install]\nWantedBy=timers.target\n",
        0o644,
    )
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "depradar-backup.timer"])
    return True


def backup_timer_active() -> bool:
    if not shutil.which("systemctl") or not Path("/run/systemd/system").exists():
        return False
    code, _ = run(["systemctl", "is-active", "--quiet", "depradar-backup.timer"], check=False)
    return code == 0


def link_tool() -> None:
