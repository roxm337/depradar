def quote_env(value: str) -> str:
    """Compose env-file quoting: single quotes are literal; otherwise escape \\ " and $."""
    if "\n" in value or "\r" in value:
        raise Abort("Configuration values cannot contain line breaks")
    if "'" not in value:
        return f"'{value}'"
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$")
    return f'"{escaped}"'


def unquote_env(raw: str) -> str:
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] == "'":
        return raw[1:-1]
    if len(raw) >= 2 and raw[0] == raw[-1] == '"':
        return re.sub(r"\\([\\\"$])", r"\1", raw[1:-1])
    return raw


def read_env(path: Path = ENV_FILE) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#") or "=" not in line:
            continue
        key, _, raw = line.partition("=")
        values[key.strip()] = unquote_env(raw)
    return values


def write_private(path: Path, content: str, mode: int = 0o600) -> None:
    """Atomic write that never exposes the content with broader permissions."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{secrets.token_hex(4)}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    with os.fdopen(descriptor, "w") as stream:
        stream.write(content)
    os.replace(temporary, path)
    os.chmod(path, mode)


def render_env(values: dict[str, str]) -> str:
    lines = [
        "# DepRadar installation settings, managed by depradarctl.",
        "# Contains secrets: keep it private and back it up separately from data archives.",
        "# Change it with `depradarctl configure`; edits by hand apply after `depradarctl restart`.",
    ]
    lines += [f"{key}={quote_env(value)}" for key, value in values.items()]
    return "\n".join(lines) + "\n"


def tls_port(state: dict[str, Any]) -> int:
    """HTTPS port. Let's Encrypt needs 443; a private CA can serve any port, beside other sites."""
    return int(state.get("port") or 443) if state["mode"] == "tls-internal" else 443


def site_address(state: dict[str, Any]) -> str:
    if state["mode"] not in {"https", "tls-internal"}:
        return ":80"
    port = tls_port(state)
    return state["domain"] if port == 443 else f"{state['domain']}:{port}"


def render_caddyfile(state: dict[str, Any]) -> str:
    mode = state["mode"]
    options = []
    if mode == "https" and state.get("email"):
        options.append(f"\temail {state['email']}")
    if mode in {"proxy", "http"}:
        options.append("\tauto_https off")
    if mode == "tls-internal":
        # Clients send no server name (SNI) when they connect to an IP address; without a
        # default, Caddy cannot pick a certificate and aborts the handshake.
        options.append(f"\tdefault_sni {state['domain']}")
    options.append("\tadmin 127.0.0.1:2019")
    # The container health check polls the admin API; keep it out of the logs.
    options.append("\tlog default {\n\t\texclude admin.api\n\t}")
    headers = [
        "\t\tX-Content-Type-Options nosniff",
        "\t\tX-Frame-Options DENY",
        "\t\tReferrer-Policy strict-origin-when-cross-origin",
        '\t\tPermissions-Policy "camera=(), microphone=(), geolocation=()"',
        "\t\t-Server",
    ]
    if mode == "https":
        headers.insert(0, '\t\tStrict-Transport-Security "max-age=31536000"')
    tls = "\ttls internal\n" if mode == "tls-internal" else ""
    return (
        "# Generated by depradarctl; run `depradarctl configure` instead of editing.\n"
        "{\n" + "\n".join(options) + "\n}\n\n"
        f"{site_address(state)} {{\n{tls}"
        "\tencode zstd gzip\n"
        "\t# Uploads are capped at 10 MiB by the API; refuse larger bodies at the edge.\n"
        "\trequest_body {\n\t\tmax_size 11MB\n\t}\n"
        "\theader {\n" + "\n".join(headers) + "\n\t}\n"
        "\t# The dashboard's same-origin proxy, then the API for pipelines, then the dashboard.\n"
        "\thandle /api/backend/* {\n\t\treverse_proxy web:3000\n\t}\n"
        "\t@api path /api/* /health/*\n"
        "\thandle @api {\n\t\treverse_proxy api:8000\n\t}\n"
        "\thandle {\n\t\treverse_proxy web:3000\n\t}\n"
        "}\n"
    )


def render_ports(state: dict[str, Any]) -> str:
    mode = state["mode"]
    if mode in {"https", "tls-internal"} and tls_port(state) == 443:
        ports = ['"80:80"', '"443:443"', '"443:443/udp"']
    elif mode == "tls-internal":
        port = tls_port(state)
        ports = [f'"{port}:{port}"', f'"{port}:{port}/udp"']
    elif mode == "proxy":
        ports = [f'"127.0.0.1:{state["port"]}:80"']
    else:
        ports = [f'"{state.get("bind") or "0.0.0.0"}:{state["port"]}:80"']
    return (
        "# Generated by depradarctl from the install mode; do not edit.\n"
        "services:\n  proxy:\n    ports:\n" + "".join(f"      - {port}\n" for port in ports)
    )


def public_url(state: dict[str, Any]) -> str:
    mode = state["mode"]
    if mode in {"https", "tls-internal"}:
        port = tls_port(state)
        return f"https://{state['domain']}" + ("" if port == 443 else f":{port}")
    if mode == "proxy":
        return state["public_url"].rstrip("/")
    port = int(state["port"])
    return f"http://{state['host']}" + ("" if port == 80 else f":{port}")


def load_state() -> dict[str, Any]:
    if not STATE_FILE.exists():
        raise Abort(
            "DepRadar is not installed on this machine",
            f"Run `sudo {ROOT / 'deploy' / 'depradarctl'} install` first.",
        )
    return json.loads(STATE_FILE.read_text())


def save_state(state: dict[str, Any]) -> None:
    write_private(STATE_FILE, json.dumps(state, indent=2, sort_keys=True) + "\n")


def apply_configuration(state: dict[str, Any], secrets_in: dict[str, str]) -> None:
    current = read_env()
    values = {
        "POSTGRES_PASSWORD": current.get("POSTGRES_PASSWORD") or secrets.token_hex(24),
        "DEPRADAR_BOOTSTRAP_TOKEN": current.get("DEPRADAR_BOOTSTRAP_TOKEN")
        or secrets.token_hex(32),
        "DEPRADAR_PUBLIC_URL": public_url(state),
        "DEPRADAR_SECURE_COOKIES": "false" if state["mode"] == "http" else "true",
        "DEPRADAR_SMTP_PASSWORD": secrets_in.get("smtp", current.get("DEPRADAR_SMTP_PASSWORD", "")),
        "DEPRADAR_TELEGRAM_BOT_TOKEN": secrets_in.get(
            "telegram", current.get("DEPRADAR_TELEGRAM_BOT_TOKEN", "")
        ),
        "DEPRADAR_CONFIG_DIR": str(CONFIG_DIR),
    }
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o750)
    write_private(ENV_FILE, render_env(values))
    write_private(CADDYFILE, render_caddyfile(state), 0o644)
    write_private(PORTS_FILE, render_ports(state), 0o644)
    save_state(state)


