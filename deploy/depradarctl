def ensure_prerequisites(facts: dict[str, Any], args: argparse.Namespace) -> None:
    release = facts["release"]
    if not facts.get("docker"):
        if not ui.confirm("Install Docker Engine from Docker's official repository?", True):
            raise Abort(
                "Docker is required", "Install Docker Engine with the Compose plugin, then re-run."
            )
        install_docker(release)
        server, compose_version = docker_versions()
        if not server or not compose_version:
            raise Abort(
                "Docker was installed but is not running", "Check `systemctl status docker`."
            )
        ui.ok(f"Docker {server} · Compose {compose_version}")
    if not facts.get("git") and ui.confirm("Install git for upgrades?", True):
        install_package("git", release)
    if facts.get("needs_swap") and not args.no_swap and not Path("/swapfile").exists():
        if ui.confirm("Add a 2 GiB swap file so image builds do not run out of memory?", True):
            create_swap()


def build_and_start(state: dict[str, Any], *, pull: bool = True, first: bool = False) -> None:
    label = "Building images (the first build takes a few minutes)" if first else "Building images"
    with ui.task(label) as task:
        compose("build", *(["--pull"] if pull else []), task=task)
    with ui.task("Starting services") as task:
        start_services(task)


def start_services(task: Task, *extra: str) -> None:
    """`compose up`, then report the failing service's own logs rather than Compose's summary."""
    code, output = compose("up", "-d", "--remove-orphans", *extra, task=task, check=False)
    if code:
        wait_healthy(task, final=True)
        raise CommandFailed(compose_command("up", "-d"), code, output.splitlines())
    wait_healthy(task)


def verify_endpoint(state: dict[str, Any], timeout: float = 180) -> bool:
    label = "Issuing the certificate and checking " if state["mode"] == "https" else "Checking "
    deadline = time.monotonic() + timeout
    result: dict[str, Any] = {}
    try:
        with ui.task(label + public_url(state)) as task:
            while True:
                result = probe(state)
                if result["ok"]:
                    break
                task.note(result["detail"])
                if time.monotonic() > deadline:
                    raise Abort(result["detail"])
                time.sleep(3)
    except Abort:
        hint = "Caddy keeps retrying. Check DNS and that ports 80 and 443 are open to the internet."
        if state["mode"] != "https":
            hint = "Inspect `depradarctl logs proxy web api`."
        _, logs = compose("logs", "--no-color", "--tail", "60", "proxy", check=False)
        errors = [
            line for line in logs.splitlines() if '"error"' in line or "error" in line.lower()
        ][-3:]
        ui.warn(
            f"{public_url(state)} is not answering yet: {result.get('detail', 'no response')}", hint
        )
        for line in errors:
            ui.info(line[:180])
        return False
    certificate = result.get("certificate")
    if certificate:
        ui.ok("Certificate", f"{certificate['issuer']} · valid until {certificate['expires']}")
    return True


def owner_password(args: argparse.Namespace) -> str | None:
    """From --owner-password-file, or two hidden prompts; None when nobody can type it."""
    password = read_secret_file(getattr(args, "owner_password_file", None))
    if password is not None:
        if not 12 <= len(password) <= 128:
            raise Abort("The owner password must contain 12–128 characters")
        return password
    if not ui.interactive or ui.assume_yes:
        return None

    def long_enough(value: str) -> str | None:
        return None if 12 <= len(value) <= 128 else "Use 12–128 characters"

    while True:
        password = ui.ask("Owner password (12–128 characters)", secret=True, validate=long_enough)
        if ui.ask("Confirm the password", secret=True, validate=lambda value: None) == password:
            return password
        ui.emit(f"      {ui.style('31', 'The passwords do not match; try again.')}", force=True)


def send_password(command: str, password: str) -> None:
    # The CLI reads the password twice from stdin; it never reaches arguments, files, or logs.
    compose("exec", "-T", "api", "depradar", command, stdin_text=f"{password}\n{password}\n")


def setup_owner(args: argparse.Namespace) -> str:
    initialized = owner_initialized()
    if initialized:
        ui.ok("Owner account already exists")
        return "existing"
    if initialized is None:
        raise Abort("Cannot reach the API to check the owner account", "Run `depradarctl doctor`.")
    if ui.interactive and not getattr(args, "owner_password_file", None) and not ui.assume_yes:
        ui.info("You sign in to the dashboard with this password. It is sent only to the API.")
    password = owner_password(args)
    if password is None:
        ui.warn("Owner account not created", "Run `sudo depradarctl owner setup` in a terminal.")
        return "pending"
    send_password("setup-owner", password)
    ui.ok("Owner account created")
    return "created"


def finish_card(state: dict[str, Any], owner: str, reachable_now: bool) -> None:
    url = public_url(state)
    rows = [
        ("Dashboard", url),
        ("CI URL", f"{url}  (DEPRADAR_URL)"),
        ("Settings", str(ENV_FILE)),
        (
            "Backups",
            f"{BACKUP_DIR} · daily" if backup_timer_active() else "manual: depradarctl backup",
        ),
        ("Log", str(LOG_DIR / "depradarctl.log")),
    ]
    ui.card("DepRadar is running" if reachable_now else "DepRadar is installed", rows)
    ui.emit()
    ui.emit(f"  {ui.bold('Next steps')}")
    if owner == "pending":
        ui.emit(f"    1. Create the owner account: {ui.accent('sudo depradarctl owner setup')}")
    else:
        ui.emit(f"    1. Sign in at {ui.accent(url)}")
    ui.emit("    2. Settings → CI/CD access: create a pipeline token, then add DEPRADAR_URL and")
    ui.emit("       DEPRADAR_TOKEN to your CI (see docs/CI_CD.md)")
    ui.emit("    3. Notifications: connect email or Telegram for alerts")
    ui.emit()
    ui.emit(f"  {ui.dim('Manage with')} depradarctl status · logs · upgrade · backup · doctor")
    ui.emit()


def cmd_install(args: argparse.Namespace) -> None:
    ui.banner(f"server installation {ui.dim('v' + TOOL_VERSION)}")
    previous = json.loads(STATE_FILE.read_text()) if STATE_FILE.exists() else {}
    if previous and not args.reconfigure:
        ui.emit()
        ui.info(
            f"An installation already exists ({public_url(previous)}); resuming it with the saved settings."
        )
        ui.info("Use `depradarctl configure` to change settings, `depradarctl upgrade` to update.")
    ui.section("Checking this server")
    facts = preflight()
    ui.section("Configuration")
    if previous and not args.reconfigure:
        state, secrets_in = previous, {}
        review(state)
    else:
        state, secrets_in = wizard(args, previous)
        ui.emit()
        review(state)
        if not ui.confirm("Install with these settings?", True):
            raise Abort("Installation cancelled; nothing was changed")
    ui.section("Preparing the server")
    preflight_ports(state)
    ensure_prerequisites(facts, args)
    state.setdefault("installed_at", now())
    state["tool_version"] = TOOL_VERSION
    if facts.get("git") or shutil.which("git"):
        state["ref"] = git("rev-parse", "HEAD", check=False) or state.get("ref", "")
    apply_configuration(state, secrets_in)
    ui.ok("Configuration written", str(CONFIG_DIR))
    ui.section("Deploying")
    build_and_start(state, first=not previous)
    reachable_now = verify_endpoint(state)
    ui.section("Owner account")
    owner = setup_owner(args)
    ui.section("Operations")
    link_tool()
    ui.ok("Command installed", str(BIN_LINK))
    if state.get("backups", {}).get("enabled") and install_backup_timer():
        ui.ok("Daily verified backups scheduled", "systemctl list-timers depradar-backup.timer")
    if not args.no_firewall:
        open_firewall(state)
    state["updated_at"] = now()
    save_state(state)
    finish_card(state, owner, reachable_now)


def preflight_ports(state: dict[str, Any]) -> None:
    mode = state["mode"]
    if mode in {"https", "tls-internal"}:
        wanted = [80, 443] if tls_port(state) == 443 else [tls_port(state)]
    else:
        wanted = [int(state["port"])]
    address = "127.0.0.1" if mode == "proxy" else (state.get("bind") or "0.0.0.0")
    if our_proxy_running():
        return
    busy = [port for port in wanted if not port_free(port, address)]
    if busy:
        raise Abort(
            f"Port{'s' if len(busy) > 1 else ''} {', '.join(map(str, busy))} "
            f"{'are' if len(busy) > 1 else 'is'} already in use on {address}",
            "Stop the service using it (`ss -ltnp` shows which). To run beside it, use "
            "`--mode tls-internal --port 8443`, or `--mode proxy` behind that web server.",
        )
    ui.ok(f"Port{'s' if len(wanted) > 1 else ''} {', '.join(map(str, wanted))} free on {address}")
    if mode == "https":
        try:
            resolved = sorted({info[4][0] for info in socket.getaddrinfo(state["domain"], 443)})
        except socket.gaierror:
            raise Abort(
                f"{state['domain']} does not resolve",
                "Create an A (and optionally AAAA) record pointing to this server, wait for it to "
                "propagate, then re-run. Let's Encrypt validates the domain over port 80.",
            ) from None
        if set(resolved) & local_addresses():
            ui.ok(f"{state['domain']} points to this server", ", ".join(resolved))
        else:
            ui.warn(
                f"{state['domain']} resolves to {', '.join(resolved)}",
                "That address is not on this machine. Expected behind cloud NAT; otherwise fix DNS first.",
            )


def cmd_configure(args: argparse.Namespace) -> None:
    ui.banner("reconfigure")
    previous = load_state()
    ui.section("Configuration")
    state, secrets_in = wizard(args, previous)
    ui.emit()
    review(state)
    if not ui.confirm("Apply these settings?", True):
        raise Abort("Nothing was changed")
    if (state["mode"], state.get("port"), state.get("bind")) != (
        previous["mode"],
        previous.get("port"),
        previous.get("bind"),
    ):
        # Free our own ports for the check, and keep serving the current address if it fails.
        compose("stop", "proxy", check=False)
        try:
            preflight_ports(state)
        except Abort:
            with ui.task(f"Keeping {public_url(previous)} online") as task:
                compose("start", "proxy", task=task, check=False)
                wait_healthy(task, timeout=120)
            ui.info("Nothing was changed.")
            raise
    apply_configuration(state, secrets_in)
    ui.ok("Configuration written", str(CONFIG_DIR))
    with ui.task("Applying") as task:
        start_services(task)
        compose("restart", "proxy", task=task)
        wait_healthy(task)
    if state.get("backups", {}).get("enabled"):
        install_backup_timer()
    elif (UNIT_DIR / "depradar-backup.timer").exists():
        run(["systemctl", "disable", "--now", "depradar-backup.timer"], check=False)
    verify_endpoint(state)
    state["updated_at"] = now()
    save_state(state)
    ui.emit()


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def backups_on_disk() -> list[Path]:
    if not BACKUP_DIR.exists():
        return []
    return sorted(
        BACKUP_DIR.glob("depradar-*.tar.gz"), key=lambda path: path.stat().st_mtime, reverse=True
    )


def make_backup(label: str = "") -> Path:
    name = f"depradar-{dt.datetime.now(dt.timezone.utc):%Y%m%dT%H%M%SZ}{('-' + label) if label else ''}.tar.gz"
    inside = f"/data/backups/{name}"
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    with ui.task("Creating a verified backup") as task:
        _, out = compose("exec", "-T", "api", "depradar", "backup", inside, task=task, capture=True)
        verified = '"verified": true' in out
        compose("cp", f"api:{inside}", str(BACKUP_DIR / name), task=task)
        compose("exec", "-T", "api", "rm", "-f", inside, check=False)
    if not verified:
        raise Abort(
            f"The backup {BACKUP_DIR / name} did not pass its restore drill",
            "Inspect it before relying on it.",
        )
    os.chmod(BACKUP_DIR / name, 0o600)
    ui.ok(f"Backup verified · {human((BACKUP_DIR / name).stat().st_size)}", str(BACKUP_DIR / name))
    return BACKUP_DIR / name


def rotate_backups(keep: int) -> None:
    scheduled = [
        path
        for path in backups_on_disk()
        if re.fullmatch(r"depradar-\d{8}T\d{6}Z\.tar\.gz", path.name)
    ]
    for path in scheduled[keep:]:
        path.unlink()
        ui.info(f"Removed old backup {path.name}")


def cmd_backup(args: argparse.Namespace) -> None:
    ui.quiet = args.quiet
    state = load_state()
    ui.banner("backup")
    ui.section("Backup")
    path = make_backup()
    rotate_backups(int(args.keep or state.get("backups", {}).get("keep", 14)))
    ui.info("Archives exclude secrets: also keep a private copy of " + str(ENV_FILE))
    if args.quiet:
        print(f"depradar backup verified: {path}")
    ui.emit()


def cmd_restore(args: argparse.Namespace) -> None:
    state = load_state()
    source = Path(args.file).resolve()
    if not source.is_file():
        raise Abort(f"{source} is not a file")
    ui.banner("restore")
    ui.section("Restore")
    ui.info(f"Archive: {source} ({human(source.stat().st_size)})")
    ui.typed_confirmation(
        "restore", "This replaces every project, finding, and setting with the archive's contents."
    )
    safety = None
    if not args.no_safety_backup and owner_initialized():
        safety = make_backup("before-restore")
    with ui.task("Stopping services and clearing data") as task:
        compose(
            "rm", "--stop", "--force", "api", "worker", "web", "proxy", "migrate", "db", task=task
        )
        for volume in VOLUMES_WITH_DATA:
            run(["docker", "volume", "rm", "-f", f"{PROJECT}_{volume}"], task=task)
    staging = Path(tempfile.mkdtemp(prefix="depradar-restore-"))
    try:
        # The API container runs as uid 10001; give it a private copy instead of loosening modes.
        os.chmod(staging, 0o711)
        staged = staging / "backup.tar.gz"
        shutil.copyfile(source, staged)
        os.chown(staged, 10001, 10001)
        os.chmod(staged, 0o600)
        with ui.task("Restoring into a fresh database") as task:
            compose("up", "-d", "db", task=task)
            compose("run", "--rm", "migrate", task=task)
            compose(
                "run",
                "--rm",
                "--no-deps",
                "-v",
                f"{staged}:/restore/backup.tar.gz:ro",
                "api",
                "depradar",
                "restore-backup",
                "/restore/backup.tar.gz",
                task=task,
            )
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    with ui.task("Starting services") as task:
        start_services(task)
    verify_endpoint(state)
    ui.ok(
        "Restored. Sessions and pipeline tokens were reset: sign in again and create new CI tokens."
    )
    if safety:
        ui.info(f"The previous data is kept in {safety}")
    ui.emit()


def cmd_upgrade(args: argparse.Namespace) -> None:
    state = load_state()
    ui.banner("upgrade")
    if not shutil.which("git") or not (ROOT / ".git").exists():
        raise Abort(
            "Upgrades need git and the original repository checkout",
            f"Expected a git checkout at {ROOT}.",
        )
    ui.section("Checking for updates")
    if git("status", "--porcelain", "--untracked-files=no") and not args.force:
        raise Abort(f"{ROOT} has local changes", "Commit or discard them, or pass --force.")
    current = git("rev-parse", "HEAD")
    with ui.task("Fetching updates") as task:
        run(
            ["git", "-c", f"safe.directory={ROOT}", "fetch", "--tags", "--prune", "origin"],
            task=task,
        )
    reference = args.ref or (
        git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False) or "origin/main"
    )
    target = git("rev-parse", f"{reference}^{{commit}}", check=False)
    if not target:
        raise Abort(f"{reference} is not a known branch, tag, or commit")
    if target == current and not args.rebuild:
        ui.ok(f"Already up to date at {git('describe', '--always', '--tags', current)}")
        ui.emit()
        return
    changes = git(
        "log", "--oneline", "--no-decorate", f"{current}..{target}", check=False
    ).splitlines()
    ui.info(
        f"{git('describe', '--always', '--tags', current)} → {git('describe', '--always', '--tags', target)}"
    )
    for line in changes[:12]:
        ui.info(ui.dim(line))
    if len(changes) > 12:
        ui.info(ui.dim(f"… and {len(changes) - 12} more"))
    migrations = git(
        "diff", "--name-only", current, target, "--", "backend/migrations", check=False
    )
    if migrations:
        ui.warn("This update changes the database schema; the pre-upgrade backup is the way back")
    if not ui.confirm("Upgrade now?", True):
        raise Abort("Nothing was changed")
    ui.section("Upgrading")
    safety = None if args.skip_backup else make_backup("before-upgrade")
    run(["git", "-c", f"safe.directory={ROOT}", "checkout", "-q", "--detach", target])
    ui.ok("Source updated", git("describe", "--always", "--tags", target))
    try:
        build_and_start(state)
        if not verify_endpoint(state, timeout=90):
            raise Abort("The upgraded service is not answering")
    except (Abort, KeyboardInterrupt) as error:
        ui.section("Rolling back")
        run(["git", "-c", f"safe.directory={ROOT}", "checkout", "-q", "--detach", current])
        try:
            build_and_start(state, pull=False)
            ui.ok("Previous version restored", git("describe", "--always", "--tags", current))
        except Abort as rollback_error:
            ui.fail("Rollback did not start cleanly", str(rollback_error))
        if migrations and safety:
            ui.warn(
                "The database may already use the newer schema",
                f"If the previous version misbehaves: sudo depradarctl restore {safety}",
            )
        raise Abort(f"Upgrade failed: {error}", getattr(error, "hint", "")) from error
    state.update(previous_ref=current, ref=target, updated_at=now(), tool_version=TOOL_VERSION)
    save_state(state)
    with ui.task("Removing unused images") as task:
        run(
            [
                "docker",
                "image",
                "prune",
                "-f",
                "--filter",
                "label=com.docker.compose.project=depradar",
            ],
            task=task,
            check=False,
        )
    ui.ok(f"Upgraded to {git('describe', '--always', '--tags', target)}")
    ui.emit()


def cmd_status(args: argparse.Namespace) -> None:
    state = load_state()
    rows = services_status()
    result = probe(state)
    backups = backups_on_disk()
    timer = ""
    if shutil.which("systemctl"):
        _, timer = run(
            ["systemctl", "list-timers", "depradar-backup.timer", "--no-legend", "--no-pager"],
            check=False,
            capture=True,
        )
    version = (
        git("describe", "--always", "--tags", "--dirty", check=False) if shutil.which("git") else ""
    )
    report = {
        "url": public_url(state),
        "mode": state["mode"],
        "version": version or state.get("ref", "")[:12],
        "endpoint": {key: result.get(key) for key in ("ok", "detail", "latency_ms", "certificate")},
        "services": {
            name: {
                "state": row.get("State"),
                "health": row.get("Health"),
                "status": row.get("Status"),
            }
            for name, row in rows.items()
        },
        "backups": {"count": len(backups), "latest": backups[0].name if backups else None},
    }
    if args.json:
        print(json.dumps(report, indent=2))
        return
    ui.banner("status")
    ui.section("Installation")
    ui.info(f"{'Address':<11} {report['url']}  {ui.dim(state['mode'])}")
    ui.info(f"{'Version':<11} {report['version']}")
    ui.info(f"{'Updated':<11} {state.get('updated_at', state.get('installed_at', '?'))}")
    ui.section("Services")
    for service in SERVICES:
        row = rows.get(service, {})
        state_text, health = row.get("State", "missing"), row.get("Health", "")
        healthy = state_text == "running" and (health in {"healthy", ""})
        mark = ui.style("32", "●") if healthy else ui.style("31", "●")
        ui.emit(f"    {mark} {service:<9} {ui.dim(row.get('Status', 'not created'))}")
    ui.section("Endpoint")
    if result["ok"]:
        ui.ok(f"{report['url']} answers", f"{result['latency_ms']} ms")
    else:
        ui.fail(
            f"{report['url']} is not answering: {result['detail']}", "Run `depradarctl doctor`."
        )
    if result.get("certificate"):
        certificate = result["certificate"]
        days = int((ssl.cert_time_to_seconds(certificate["expires"]) - time.time()) // 86400)
        (ui.ok if days > 14 else ui.warn)(
            f"Certificate from {certificate['issuer']}", f"expires in {days} days"
        )
    ui.section("Backups")
    if backups:
        age = (time.time() - backups[0].stat().st_mtime) / 3600
        (ui.ok if age < 36 else ui.warn)(
            f"{len(backups)} archive{'s' if len(backups) != 1 else ''} · latest {backups[0].name}",
            f"{age:.0f} h ago",
        )
    else:
        ui.warn("No backups yet", "Create one with `sudo depradarctl backup`.")
    if timer.strip():
        ui.info("Next scheduled: " + " ".join(timer.split()[:4]))
    elif not Path("/run/systemd/system").exists():
        ui.info("No systemd on this host: run `depradarctl backup --quiet` from cron.")
    elif state.get("backups", {}).get("enabled"):
        ui.warn(
            "The daily backup timer is not active", "Re-run `depradarctl configure` to schedule it."
        )
    ui.emit()


def cmd_doctor(args: argparse.Namespace) -> None:
    state = load_state()
    ui.banner("doctor")
    ui.section("Host")
    preflight()
    ui.section("Configuration")
    for path in (ENV_FILE, CADDYFILE, PORTS_FILE):
        if not path.exists():
            ui.fail(f"{path} is missing", "Run `depradarctl configure` to regenerate it.")
        elif path == ENV_FILE and path.stat().st_mode & 0o077:
            ui.warn(f"{path} is readable by other users", f"Fix with `chmod 600 {path}`.")
        else:
            ui.ok(str(path))
    code, out = compose("config", "--quiet", check=False)
    (
        ui.ok("Compose configuration is valid")
        if code == 0
        else ui.fail("Compose configuration is invalid", out.splitlines()[-1] if out else "")
    )
    ui.section("Services")
    rows = services_status()
    problems = 0
    for service in SERVICES:
        row = rows.get(service)
        if not row:
            ui.fail(f"{service} is not created", "Run `depradarctl start`.")
            problems += 1
            continue
        state_text, health = row.get("State"), row.get("Health", "")
        if state_text == "running" and health in {"healthy", ""}:
            ui.ok(service, row.get("Status", ""))
            continue
        problems += 1
        ui.fail(f"{service}: {row.get('Status', state_text)}")
        _, logs = compose("logs", "--no-color", "--tail", "80", service, check=False)
        for line in [
            line
            for line in logs.splitlines()
            if re.search(r"error|fatal|exception|denied", line, re.I)
        ][-4:]:
            ui.info(line[:180])
    ui.section("Endpoint")
    result = probe(state)
    if result["ok"]:
        ui.ok(f"{public_url(state)} answers", f"{result['latency_ms']} ms")
    else:
        problems += 1
        ui.fail(f"{public_url(state)}: {result['detail']}")
    initialized = owner_initialized()
    if initialized is False:
        ui.warn("No owner account yet", "Create it with `sudo depradarctl owner setup`.")
    ui.emit()
    if problems:
        raise Abort(
            f"{problems} problem{'s' if problems != 1 else ''} found",
            "Details: `depradarctl logs <service>`.",
        )
    ui.ok("Everything looks healthy")
    ui.emit()


def cmd_logs(args: argparse.Namespace) -> None:
    load_state()
    unknown = sorted(set(args.services) - {*SERVICES, "migrate"})
    if unknown:
        raise Abort(f"Unknown service {', '.join(unknown)}", "Choose from: " + ", ".join(SERVICES))
    command = compose_command(
        "logs", "--tail", str(args.tail), *(["--follow"] if args.follow else []), *args.services
    )
    raise SystemExit(attached(command))


def cmd_lifecycle(args: argparse.Namespace) -> None:
    state = load_state()
    ui.banner(args.command)
    ui.section(args.command.capitalize())
    if args.command == "stop":
        with ui.task("Stopping services") as task:
            compose("stop", task=task)
        ui.emit()
        return
    with ui.task("Starting services" if args.command == "start" else "Restarting services") as task:
        start_services(task, *(["--force-recreate"] if args.command == "restart" else []))
    verify_endpoint(state, timeout=60)
    ui.emit()


