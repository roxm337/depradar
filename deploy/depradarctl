# ─── Preflight ───────────────────────────────────────────────────────────────────────────────


def preflight() -> dict[str, Any]:
    """Inspect the host. Returns facts; raises Abort only for hard blockers."""
    facts: dict[str, Any] = {}
    if platform.system() != "Linux":
        raise Abort(
            "depradarctl manages Linux servers",
            "Use Docker Compose directly for local development (see README.md).",
        )
    release = os_release()
    facts["release"] = release
    machine = platform.machine()
    if machine not in {"x86_64", "amd64", "aarch64", "arm64"}:
        raise Abort(
            f"Unsupported CPU architecture {machine}",
            "The pinned scanner is published for x86_64 and arm64.",
        )
    memory = meminfo()
    total, swap = memory.get("MemTotal", 0), memory.get("SwapTotal", 0)
    facts.update(memory=total, swap=swap)
    disk = shutil.disk_usage("/var/lib/docker" if Path("/var/lib/docker").exists() else "/")
    facts["disk_free"] = disk.free
    ui.ok(
        f"{release.get('PRETTY_NAME', 'Linux')} · {machine}",
        f"{os.cpu_count()} CPU · {gib(total)} RAM · {gib(swap)} swap · {gib(disk.free)} free",
    )
    if disk.free < 6 * 1024**3:
        raise Abort(
            f"Only {gib(disk.free)} of disk space is free",
            "DepRadar needs at least 6 GiB for images and data.",
        )
    if disk.free < 12 * 1024**3:
        ui.warn(f"{gib(disk.free)} free; 12 GiB or more leaves room for upgrades and backups")
    if total and total < 900 * 1024**2:
        raise Abort(
            f"{gib(total)} of memory is too little", "DepRadar needs at least 1 GiB of RAM."
        )
    facts["needs_swap"] = total + swap < 2 * 1024**3
    if facts["needs_swap"]:
        ui.warn(f"{gib(total + swap)} of memory and swap; image builds need about 2 GiB")
    server, compose_version = docker_versions()
    facts.update(docker=server, compose=compose_version)
    if server and compose_version:
        if version_tuple(server) < MIN_DOCKER:
            raise Abort(
                f"Docker {server} is too old",
                f"Upgrade to Docker {'.'.join(map(str, MIN_DOCKER))} or newer.",
            )
        if version_tuple(compose_version) < MIN_COMPOSE:
            raise Abort(
                f"Docker Compose {compose_version} is too old",
                "Upgrade the docker-compose-plugin package to 2.24 or newer.",
            )
        ui.ok(f"Docker {server} · Compose {compose_version}")
    elif shutil.which("docker") and not server:
        raise Abort(
            "Docker is installed but its daemon is not reachable",
            "Start it with `systemctl start docker`, then re-run.",
        )
    else:
        ui.warn("Docker Engine is not installed")
    facts["git"] = bool(shutil.which("git"))
    if not facts["git"]:
        ui.warn("git is not installed; upgrades need it")
    unreachable = [
        host
        for host in ("registry-1.docker.io", "github.com", "api.osv.dev")
        if not reachable(host)
    ]
    if unreachable:
        ui.warn(
            "Cannot reach " + ", ".join(unreachable),
            "Image builds and vulnerability lookups need outbound HTTPS.",
        )
    else:
        ui.ok("Outbound HTTPS to Docker Hub, GitHub, and OSV")
    return facts


