def validate_domain(value: str) -> str | None:
    try:
        ipaddress.ip_address(value)
        return "Use a domain name; certificates cannot be issued for an IP address"
    except ValueError:
        pass
    return None if HOSTNAME.match(value) else "Enter a domain such as depradar.example.com"


def validate_host(value: str) -> str | None:
    try:
        ipaddress.ip_address(value)
        return None
    except ValueError:
        return (
            None
            if HOSTNAME.match(value) or value == "localhost"
            else "Enter a hostname or IP address"
        )


def validate_port(value: str) -> str | None:
    return (
        None if value.isdigit() and 1 <= int(value) <= 65535 else "Enter a port between 1 and 65535"
    )


def validate_url(value: str) -> str | None:
    parsed = urllib.parse.urlsplit(value)
    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.hostname
        or parsed.path not in {"", "/"}
    ):
        return "Enter the public origin, such as https://depradar.example.com (no path)"
    return None


def read_secret_file(path: str | None) -> str | None:
    if not path:
        return None
    try:
        return Path(path).read_text().rstrip("\r\n")
    except OSError as error:
        raise Abort(f"Cannot read {path}: {error.strerror}") from error


def guess_host() -> str:
    for address in sorted(local_addresses()):
        try:
            parsed = ipaddress.ip_address(address)
        except ValueError:
            continue
        if parsed.version == 4 and not parsed.is_loopback:
            return address
    return "localhost"


def wizard(
    args: argparse.Namespace, previous: dict[str, Any]
) -> tuple[dict[str, Any], dict[str, str]]:
    state = dict(previous)
    mode = args.mode or ui.choose(
        "How should DepRadar be reached?", MODES, previous.get("mode", "https")
    )
    if mode not in MODES:
        raise Abort(f"Unknown mode {mode}", "Choose one of: " + ", ".join(MODES))
    state["mode"] = mode
    for key in ("domain", "email", "public_url", "host", "port", "bind"):
        if previous.get("mode") != mode:
            state.pop(key, None)
    if mode in {"https", "tls-internal"}:
        check = validate_domain if mode == "https" else validate_host
        label = "Domain name" if mode == "https" else "Domain name or IP address"
        state["domain"] = args.domain or ui.ask(label, state.get("domain"), validate=check)
        error = check(state["domain"])
        if error:
            raise Abort(error)
        if mode == "tls-internal":
            # Another site may already own 443; a private CA works on any port.
            state["port"] = int(
                args.port
                or ui.ask("HTTPS port", str(state.get("port", 443)), validate=validate_port)
            )
        elif args.port and args.port != 443:
            raise Abort(
                "Let's Encrypt needs ports 80 and 443",
                "Use --mode tls-internal for another port, or --mode proxy behind your web server.",
            )
        if mode == "https":
            email = (
                args.email
                if args.email is not None
                else ui.ask(
                    "Email for certificate notices",
                    state.get("email"),
                    optional=True,
                    validate=lambda value: None if EMAIL.match(value) else "Enter an email address",
                )
            )
            if email and not EMAIL.match(email):
                raise Abort("Enter a valid --email address")
            state["email"] = email
    elif mode == "proxy":
        state["public_url"] = args.public_url or ui.ask(
            "Public URL your proxy serves", state.get("public_url"), validate=validate_url
        )
        if validate_url(state["public_url"]):
            raise Abort(validate_url(state["public_url"]) or "")
        state["port"] = int(
            args.port
            or ui.ask(
                "Local port for your proxy to target",
                str(state.get("port", 8080)),
                validate=validate_port,
            )
        )
    else:
        state["host"] = args.host or ui.ask(
            "Hostname or IP users will open",
            state.get("host") or guess_host(),
            validate=validate_host,
        )
        state["port"] = int(
            args.port or ui.ask("Port", str(state.get("port", 80)), validate=validate_port)
        )
        state["bind"] = args.bind or state.get("bind") or "0.0.0.0"
        ui.warn(
            "Plain HTTP sends passwords and tokens unencrypted; use it only on a trusted network"
        )
    current = read_env()
    secrets_in: dict[str, str] = {}
    prompts = (
        (
            "smtp",
            "SMTP password for email alerts",
            "DEPRADAR_SMTP_PASSWORD",
            args.smtp_password_file,
        ),
        (
            "telegram",
            "Telegram bot token for chat alerts",
            "DEPRADAR_TELEGRAM_BOT_TOKEN",
            args.telegram_token_file,
        ),
    )
    if ui.interactive and not ui.assume_yes:
        ui.info(
            "Email and Telegram are set up in the dashboard; only their secrets are stored here."
        )
    for key, label, variable, path in prompts:
        value = read_secret_file(path)
        if value is None and ui.interactive and not ui.assume_yes:
            if current.get(variable):
                if ui.confirm(f"Replace the stored {label.split(' for ')[0]}?", False):
                    value = ui.ask(label, None, secret=True, optional=True)
            else:
                value = ui.ask(label, None, secret=True, optional=True) or None
        if value is not None:
            secrets_in[key] = value
    backups = state.get("backups", {"enabled": True, "keep": 14})
    if args.no_backups:
        backups["enabled"] = False
    elif ui.interactive and not ui.assume_yes:
        backups["enabled"] = ui.confirm(
            "Schedule verified daily backups?", backups.get("enabled", True)
        )
    if args.keep_backups:
        backups["keep"] = args.keep_backups
    state["backups"] = backups
    return state, secrets_in


def review(state: dict[str, Any]) -> None:
    rows = [("Mode", f"{state['mode']} · {MODES[state['mode']]}"), ("Address", public_url(state))]
    if state["mode"] == "proxy":
