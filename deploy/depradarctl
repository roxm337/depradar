class CommandFailed(Abort):
    def __init__(self, command: list[str], code: int, tail: list[str]) -> None:
        detail = "\n".join(f"│ {ANSI.sub('', line).strip()[:200]}" for line in tail[-15:])
        super().__init__(
            f"`{shlex.join(command[:6])}{' …' if len(command) > 6 else ''}` exited with {code}",
            (detail + "\n" if detail else "") + f"Full log: {LOG_DIR / 'depradarctl.log'}",
        )
        self.code = code
        self.tail = tail


def run(
    command: list[str],
    *,
    task: Task | None = None,
    check: bool = True,
    stdin_text: str | None = None,
    capture: bool = False,
    env: dict[str, str] | None = None,
) -> tuple[int, str]:
    """Run a command, streaming output to the log and the active spinner."""
    ui.record(f"$ {shlex.join(command)}")
    merged = {**os.environ, "BUILDKIT_PROGRESS": "plain", **(env or {})}
    try:
        process = subprocess.Popen(
            command,
            cwd=ROOT,
            env=merged,
            stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            bufsize=1,
        )
    except FileNotFoundError as error:
        raise Abort(f"{command[0]} is not installed") from error
    if stdin_text is not None:
        assert process.stdin is not None
        process.stdin.write(stdin_text)
        process.stdin.close()
    tail: deque[str] = deque(maxlen=200)
    output: list[str] = []
    assert process.stdout is not None
    for line in process.stdout:
        line = line.rstrip("\n")
        if ui.log:
            ui.log.write(ANSI.sub("", line) + "\n")
        tail.append(line)
        if capture:
            output.append(line)
        if task:
            task.note(line)
    code = process.wait()
    if ui.log:
        ui.log.flush()
    if check and code:
        raise CommandFailed(command, code, list(tail))
    return code, "\n".join(output if capture else tail)


def attached(command: list[str]) -> int:
    """Run with the operator's terminal, for prompts and live logs."""
    ui.record(f"$ {shlex.join(command)} (attached)")
    return subprocess.call(command, cwd=ROOT)


def git(*args: str, check: bool = True) -> str:
    _, out = run(["git", "-c", f"safe.directory={ROOT}", *args], capture=True, check=check)
    return out.strip()


