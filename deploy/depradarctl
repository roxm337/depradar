def os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    for candidate in (Path("/etc/os-release"), Path("/usr/lib/os-release")):
        if candidate.exists():
            for line in candidate.read_text().splitlines():
                if "=" in line:
                    key, _, value = line.partition("=")
                    values[key] = value.strip().strip('"')
            break
    return values


def version_tuple(text: str) -> tuple[int, ...]:
    return tuple(int(part) for part in re.findall(r"\d+", text)[:3]) or (0,)


def meminfo() -> dict[str, int]:
    values = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            values[key] = int(rest.split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return values


def gib(value: float) -> str:
    return f"{value / 1024**3:.1f} GiB"


def human(size: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} GB"


def docker_versions() -> tuple[str | None, str | None]:
    if not shutil.which("docker"):
        return None, None
    code, server = run(
        ["docker", "version", "--format", "{{.Server.Version}}"], check=False, capture=True
    )
    compose_code, compose_version = run(
        ["docker", "compose", "version", "--short"], check=False, capture=True
    )
    return (server.strip() if code == 0 else None), (
        compose_version.strip() if compose_code == 0 else None
    )


def port_free(port: int, address: str = "0.0.0.0") -> bool:
    family = socket.AF_INET6 if ":" in address else socket.AF_INET
    with socket.socket(family, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind((address, port))
        except OSError:
            return False
    return True


def our_proxy_running() -> bool:
    if not ENV_FILE.exists() or not PORTS_FILE.exists():
        return False
    code, out = compose("ps", "--status", "running", "--services", check=False, capture=True)
    return code == 0 and "proxy" in out.split()


def local_addresses() -> set[str]:
    found: set[str] = set()
    code, out = (
        run(["hostname", "-I"], check=False, capture=True) if shutil.which("hostname") else (1, "")
    )
    if code == 0:
        found.update(out.split())
    try:
        found.update(info[4][0] for info in socket.getaddrinfo(socket.gethostname(), None))
    except OSError:
        pass
    return found


def reachable(host: str, port: int = 443, timeout: float = 4) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


# ─── Probing the running service ─────────────────────────────────────────────────────────────


def probe(state: dict[str, Any], path: str = "/health/ready") -> dict[str, Any]:
    """Request a path through the edge proxy exactly as a browser would, from this host."""
    mode = state["mode"]
    parsed = urllib.parse.urlsplit(public_url(state))
    host_header = parsed.netloc
    started = time.monotonic()
    result: dict[str, Any] = {"ok": False, "status": None, "detail": "", "certificate": None}
    try:
        if mode in {"https", "tls-internal"}:
            context = ssl.create_default_context()
            if mode == "tls-internal":
                context.check_hostname = False
                context.verify_mode = ssl.CERT_NONE
            raw = socket.create_connection(("127.0.0.1", tls_port(state)), timeout=8)
            connection = context.wrap_socket(raw, server_hostname=state["domain"])
            certificate = connection.getpeercert()
            if certificate:
                issuer = dict(item[0] for item in certificate.get("issuer", ()))
                result["certificate"] = {
                    "issuer": issuer.get("organizationName") or issuer.get("commonName", ""),
                    "expires": certificate.get("notAfter"),
                }
        else:
            target = (
                "127.0.0.1"
                if mode == "proxy" or state.get("bind") in {None, "", "0.0.0.0"}
                else state["bind"]
            )
            connection = socket.create_connection((target, int(state["port"])), timeout=8)
        with connection:
            request = f"GET {path} HTTP/1.1\r\nHost: {host_header}\r\nConnection: close\r\nUser-Agent: depradarctl\r\n\r\n"
            connection.sendall(request.encode())
            response = b""
            while chunk := connection.recv(65536):
                response += chunk
                if len(response) > 1_000_000:
                    break
        head, _, body = response.partition(b"\r\n\r\n")
        status = int(head.split(b" ", 2)[1]) if head.startswith(b"HTTP/") else None
        result.update(status=status, ok=status == 200, body=body.decode(errors="replace")[:2000])
        result["detail"] = f"HTTP {status}"
    except ssl.SSLCertVerificationError as error:
        result["detail"] = f"certificate not trusted yet ({error.verify_message})"
    except (OSError, ValueError, IndexError) as error:
        result["detail"] = str(error) or error.__class__.__name__
    result["latency_ms"] = int((time.monotonic() - started) * 1000)
    return result


def services_status() -> dict[str, dict[str, Any]]:
    code, out = compose("ps", "-a", "--format", "json", check=False, capture=True)
    rows: list[dict[str, Any]] = []
    if code == 0 and out.strip():
        text = out.strip()
        try:
            parsed = json.loads(text)
            rows = parsed if isinstance(parsed, list) else [parsed]
        except json.JSONDecodeError:
            rows = [json.loads(line) for line in text.splitlines() if line.strip().startswith("{")]
    return {row.get("Service", ""): row for row in rows}


def service_logs(service: str, lines: int = 12) -> str:
    """The service's own recent output, without Compose's name prefix, as a hint block."""
    _, logs = compose("logs", "--no-color", "--tail", "60", service, check=False)
    tail: list[str] = []
    for line in logs.splitlines():
        text = line.split("|", 1)[-1].strip()
        if text and (not tail or tail[-1] != text):  # a crash loop repeats the same lines
            tail.append(text)
    return "\n".join(f"│ {line[:200]}" for line in tail[-lines:])


def wait_healthy(task: Task, timeout: float = 600, final: bool = False) -> None:
    """Wait until every service is healthy; fail fast with the logs of one that stopped."""
    deadline = time.monotonic() + timeout
    while True:
        rows = services_status()
        migrate = rows.get("migrate", {})
        if migrate.get("State") == "exited" and migrate.get("ExitCode") not in (0, None):
            raise Abort("Database migration failed", service_logs("migrate"))
        pending = []
        for service in SERVICES:
            row = rows.get(service, {})
            state, health = row.get("State", "missing"), row.get("Health", "")
            if state in {"exited", "dead", "restarting"}:
                raise Abort(
                    f"The {service} service stopped while starting",
                    service_logs(service) + f"\nInspect: depradarctl logs {service}",
                )
            healthy = health == "healthy" or (service in NO_HEALTHCHECK and not health)
            if state != "running" or not healthy:
                pending.append(service)
        if not pending or final:
            return
        ready = len(SERVICES) - len(pending)
        task.note(f"{ready}/{len(SERVICES)} ready · waiting for {', '.join(pending)}")
        if time.monotonic() > deadline:
            raise Abort(
                f"Services did not become healthy within {int(timeout)}s: {', '.join(pending)}",
                "Inspect them with `depradarctl logs " + " ".join(pending) + "`.",
            )
        time.sleep(2)


def owner_initialized() -> bool | None:
    script = (
        "import json,urllib.request;"
        "print(json.load(urllib.request.urlopen('http://localhost:8000/api/auth/status',timeout=5))['initialized'])"
    )
    code, out = compose("exec", "-T", "api", "python", "-c", script, check=False, capture=True)
    if code:
        return None
    return out.strip().splitlines()[-1] == "True"


